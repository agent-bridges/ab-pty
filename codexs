#!/usr/bin/env bash
set -euo pipefail

# Canonical Codex launcher for AB PTY sessions.
#
# UI-created sessions pass --ab-label explicitly, so web and mobile use the
# same launcher contract. A person starting `codexs` in an existing terminal
# omits it and gets the current folder name. The AB-only option is consumed
# here and never reaches Codex.
label=""
label_supplied=0
starts_app_server=0
codex_args=()

while (($#)); do
  case "$1" in
    --ab-label)
      (($# >= 2)) || { echo "codexs: --ab-label requires a value" >&2; exit 2; }
      label="$2"
      label_supplied=1
      shift 2
      ;;
    --ab-label=*)
      label="${1#--ab-label=}"
      label_supplied=1
      shift
      ;;
    app-server)
      starts_app_server=1
      codex_args+=("$1")
      shift
      ;;
    *)
      codex_args+=("$1")
      shift
      ;;
  esac
done

if [[ -n "${AB_PTY_SESSION_ID:-}" && "${starts_app_server}" -eq 0 ]]; then
  if [[ "${label_supplied}" -eq 0 ]]; then
    label="$(basename -- "$PWD")"
  fi
  [[ -n "${label}" ]] || { echo "codexs: session label is empty" >&2; exit 2; }
  command -v ab >/dev/null 2>&1 || { echo "codexs: the AB client is not installed" >&2; exit 127; }
  if ! ab sessions label "${AB_PTY_SESSION_ID}" "${label}" >/dev/null; then
    echo "codexs: failed to set the PTY label" >&2
    exit 1
  fi
fi

exec codex --sandbox danger-full-access --ask-for-approval never "${codex_args[@]}"
