#!/usr/bin/env bash
set -euo pipefail

# Canonical Codex launcher for AB PTY sessions.
#
# UI-created sessions pass --ab-label explicitly, so web and mobile use the
# same launcher contract. A person starting plain `codexs` in an existing
# terminal resumes the newest Codex conversation recorded for the current
# folder. The AB-only option is consumed here and never reaches Codex.
label=""
label_supplied=0
starts_app_server=0
has_remote=0
codex_args=()

while (($#)); do
  case "$1" in
    --ab-label)
      (($# >= 2)) || { echo "codexs: --ab-label requires a value" >&2; exit 2; }
      label="$2"
      label_supplied=1
      shift 2
      ;;
    --ab-label=*)
      label="${1#--ab-label=}"
      label_supplied=1
      shift
      ;;
    app-server)
      starts_app_server=1
      codex_args+=("$1")
      shift
      ;;
    --remote)
      (($# >= 2)) || { echo "codexs: --remote requires a value" >&2; exit 2; }
      has_remote=1
      codex_args+=("$1" "$2")
      shift 2
      ;;
    --remote=*)
      has_remote=1
      codex_args+=("$1")
      shift
      ;;
    --sandbox|-s|--ask-for-approval|-a)
      echo "codexs: permission flags are fixed to full access" >&2
      exit 2
      ;;
    --sandbox=*|--ask-for-approval=*|--approve-for-me|--full-auto)
      echo "codexs: permission flags are fixed to full access" >&2
      exit 2
      ;;
    --dangerously-bypass-approvals-and-sandbox|--yolo)
      # The wrapper adds the canonical full-access flag exactly once.
      shift
      ;;
    *)
      codex_args+=("$1")
      shift
      ;;
  esac
done

if [[ "${starts_app_server}" -eq 0 && "${#codex_args[@]}" -eq 0 ]]; then
  codex_args=(-C "$PWD" resume --last)
fi

if [[ -n "${AB_PTY_SESSION_ID:-}" && "${starts_app_server}" -eq 0 ]]; then
  if [[ "${label_supplied}" -eq 0 ]]; then
    label="$(basename -- "$PWD")"
  fi
  [[ -n "${label}" ]] || { echo "codexs: session label is empty" >&2; exit 2; }
  command -v ab >/dev/null 2>&1 || { echo "codexs: the AB client is not installed" >&2; exit 127; }
  if ! ab sessions label "${AB_PTY_SESSION_ID}" "${label}" >/dev/null; then
    echo "codexs: failed to set the PTY label" >&2
    exit 1
  fi

  if [[ "${has_remote}" -eq 0 ]]; then
    runtime_uri=""
    if ! runtime_uri="$(ab sessions codex-runtime "${AB_PTY_SESSION_ID}" --cwd "$PWD")"; then
      echo "codexs: failed to start the daemon-owned Codex runtime" >&2
      exit 1
    fi
    [[ "${runtime_uri}" == unix://* ]] || { echo "codexs: daemon returned an invalid Codex runtime address" >&2; exit 1; }
    codex_args=(--remote "${runtime_uri}" "${codex_args[@]}")
  fi
fi

exec codex --dangerously-bypass-approvals-and-sandbox "${codex_args[@]}"
